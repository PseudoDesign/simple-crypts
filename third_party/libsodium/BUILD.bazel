load("//build:defs.bzl", "sodium_library")

package(default_visibility = ["//visibility:public"])

alias(
    name = "sources",
    actual = "@libsodium//:sources",
)

alias(
    name = "headers",
    actual = "@libsodium//:headers",
)

sodium_library(
    name = "sodium",
    srcs = [":sources"],
    hdrs = [":headers"],
    configure = "@libsodium//:configure",
)

sodium_library(
    name = "sodium_arm",
    srcs = [":sources"],
    hdrs = [":headers"],
    arm = True,
    configure = "@libsodium//:configure",
)

filegroup(
    name = "quality_sources",
    srcs = ["BUILD.bazel"],
)
