load("//build:defs.bzl", "py_binary", "py_test")
load("//web:defs.bzl", "wasm_build")
load(":defs.bzl", "fleet_site")

package(default_visibility = ["//visibility:public"])

wasm_build(
    name = "module",
    inputs = [
        "//examples/common:endpoint.h",
        "//core:sources",
        "//providers/sodium:sources",
        "//schema:sources",
        "//third_party/nanopb:sources",
        "//third_party/libsodium:headers",
    ],
    kind = "module",
    output = "server.mjs",
    persistent = True,
    sodium = "//web:sodium",
    sources = [
        "//examples/common:endpoint.c",
        "//core:sc.c",
        "//providers/sodium:sc_sodium.c",
        "//schema:sc.pb.c",
        "@nanopb//:pb_common.c",
        "@nanopb//:pb_encode.c",
        "@nanopb//:pb_decode.c",
    ],
)

fleet_site(
    name = "site",
    assets = [
        "index.html",
        "style.css",
        "app.mjs",
        "worker.mjs",
        "transport.mjs",
        "//examples/common:endpoint.mjs",
        "//examples/common:storage.mjs",
    ],
)

py_binary(
    name = "preview",
    data = [":site"],
    main = "preview.py",
)

py_test(
    name = "protocol_test",
    data = [
        "protocol_test.mjs",
        "transport.mjs",
        ":module",
        "//examples/common:endpoint.mjs",
        "//examples/device_console:module",
    ],
    main = "run_protocol_test.py",
)

exports_files(["site.py"])

py_test(
    name = "browser_test",
    data = [
        "browser_test.mjs",
        ":site",
        "//web:browser_packages",
    ],
    main = "run_browser_test.py",
    tags = [
        "local",
        "manual",
    ],
)

# Package-local files avoid following build-output or SDK directory symlinks.
filegroup(
    name = "quality_sources",
    srcs = glob(["*"]),
    visibility = ["//visibility:public"],
)
