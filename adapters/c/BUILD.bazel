load("//build:defs.bzl", "c_binary")

package(default_visibility = ["//visibility:public"])

c_binary(
    name = "adapter",
    testonly = True,
    srcs = ["main.c"],
    copts = ["-DSC_ENABLE_TESTING"],
    visibility = [
        "//examples:__pkg__",
        "//tests:__pkg__",
        "//tools:__pkg__",
        "//web:__pkg__",
    ],
    deps = ["//providers/host:host_testing"],
)

filegroup(
    name = "sources",
    srcs = ["main.c"],
)

# Package-local files avoid following build-output or SDK directory symlinks.
filegroup(
    name = "quality_sources",
    srcs = glob(["*"]),
    visibility = ["//visibility:public"],
)
