load("//build:defs.bzl", "c_binary", "py_test", "sdk_binary", "sdk_test")

package(default_visibility = ["//visibility:public"])

c_binary(
    name = "oracle_sodium",
    srcs = ["oracle_sodium.c"],
    deps = ["//third_party/libsodium:sodium"],
)

sdk_binary(
    name = "oracle_go",
    srcs = [
        "go.mod",
        "go.sum",
        "oracle.go",
    ] + glob(["vendor/**"]),
    kind = "go",
    module = "tests/crypto",
    sdk = "@go_sdk//:files",
    sdk_marker = "@go_sdk//:bin/go",
)

py_test(
    name = "interop",
    data = [
        "vector.json",
        ":oracle_go",
        ":oracle_sodium",
        "//tests:coordinator.py",
    ],
    main = "interop.py",
    script_args = [
        "--sodium",
        "tests/crypto/oracle_sodium",
        "--go",
        "tests/crypto/oracle_go",
        "--vector",
        "tests/crypto/vector.json",
    ],
)

# Package-local files avoid following build-output or SDK directory symlinks.
filegroup(
    name = "quality_sources",
    srcs = glob(["*"]),
    visibility = ["//visibility:public"],
)

sdk_test(
    name = "lint",
    srcs = [
        "go.mod",
        "go.sum",
        "oracle.go",
    ] + glob(["vendor/**"]),
    kind = "go",
    module = "tests/crypto",
    quality = True,
    sdk = "@go_sdk//:files",
    sdk_marker = "@go_sdk//:bin/go",
)
