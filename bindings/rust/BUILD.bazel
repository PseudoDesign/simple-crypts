load("//build:defs.bzl", "sdk_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob([
        "src/**",
        "Cargo.*",
    ]),
)

sdk_test(
    name = "sdk_test",
    srcs = [
        ":sources",
        "//third_party/rust_crates:sources",
    ],
    kind = "rust",
    module = "bindings/rust",
    sdk = "@rust_sdk//:files",
    sdk_marker = "@rust_sdk//:bin/rustc",
    shared = "//providers/host:libsimplecrypts_testing",
    test_build = True,
)

exports_files(["src/resources.rs"])
