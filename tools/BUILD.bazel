load("//build:defs.bzl", "c_analysis_database", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "build_action.py",
    "bootstrap.py",
    "downloads.lock.json",
    "quality.py",
])

py_test(
    name = "schema_check",
    data = [
        "//schema:sc.options",
        "//schema:sc.pb.c",
        "//schema:sc.pb.h",
        "//schema:sc.proto",
        "//third_party/nanopb:generator",
        "@protobuf_sdk//:files",
    ],
    main = "check_schema.py",
)

py_test(
    name = "test_report_test",
    data = ["test_report.py"],
    main = "test_report_test.py",
)

py_test(
    name = "resource_schema_check",
    data = [
        "//bindings/go:resources.go",
        "//bindings/python:resources.py",
        "//bindings/rust:src/resources.rs",
        "//schema:resources.h",
        "//schema:resources.json",
        "//schema:test_resources.h",
        "//schema:test_resources.json",
        "//web:resources.mjs",
    ],
    main = "resource_schema.py",
    script_args = ["--check"],
)

c_analysis_database(
    name = "analysis_database",
    deps = [
        "//providers/host",
        "//providers/host:host_testing",
    ],
)

QUALITY_INPUTS = [
    "quality.py",
    "build_action.py",
    "//:.clang-format",
    "//:.clang-tidy",
    "//core:sources",
    "//providers/host:sources",
    "//providers/sodium:sources",
    "//schema:sources",
    "//third_party/nanopb:sources",
    "//third_party/libsodium:headers",
]

py_test(
    name = "format_check",
    data = QUALITY_INPUTS,
    main = "quality.py",
    script_args = ["--format-check"],
)

py_test(
    name = "lint",
    data = QUALITY_INPUTS + [":analysis_database"],
    main = "quality.py",
    script_args = [
        "--lint",
        "tools/analysis_database.json",
    ],
)

test_suite(
    name = "quality",
    tests = [
        ":format_check",
        ":lint",
        ":quality_test",
        "//docs:api_check",
        "//docs:example",
    ],
)

py_test(
    name = "quality_test",
    data = QUALITY_INPUTS + [
        "//docs:build_api.py",
        "//docs:doc_inputs",
    ],
    main = "quality_test.py",
)
