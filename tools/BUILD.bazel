load("//build:defs.bzl", "c_analysis_database", "py_binary", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "dependency_paths.py",
    "build_action.py",
    "bootstrap.py",
    "downloads.lock.json",
    "quality.py",
    "repository_quality.py",
    "source_policy.py",
])

py_test(
    name = "dependency_lock_check",
    data = [
        "//bindings/rust:Cargo.lock",
        "//build:dependencies.lock.json",
        "//tests/crypto:go.sum",
    ],
    main = "lock_dependencies.py",
    script_args = ["--check"],
)

py_test(
    name = "schema_check",
    data = [
        "dependency_paths.py",
        "//build:dependency_paths",
        "//schema:sc.options",
        "//schema:sc.pb.c",
        "//schema:sc.pb.h",
        "//schema:sc.proto",
        "//third_party/nanopb:generator",
        "@protobuf_sdk//:files",
    ],
    main = "check_schema.py",
)

py_binary(
    name = "schema_generate",
    data = [
        "dependency_paths.py",
        "//build:dependency_paths",
        "//schema:sc.options",
        "//schema:sc.proto",
        "//third_party/nanopb:generator",
        "@protobuf_sdk//:files",
    ],
    main = "check_schema.py",
    script_args = ["--write"],
)

py_test(
    name = "test_report_test",
    data = ["test_report.py"],
    main = "test_report_test.py",
)

py_test(
    name = "resource_schema_check",
    data = [
        "//bindings/go:resources.go",
        "//bindings/python:resources.py",
        "//bindings/rust:src/resources.rs",
        "//schema:resources.h",
        "//schema:resources.json",
        "//schema:test_resources.h",
        "//schema:test_resources.json",
        "//web:resources.mjs",
    ],
    main = "resource_schema.py",
    script_args = ["--check"],
)

c_analysis_database(
    name = "analysis_database",
    testonly = True,
    deps = [
        "//adapters/c:adapter",
        "//docs:example",
        "//examples/device_console:module",
        "//examples/fleet_manager:module",
        "//platforms/cortex_m4:resource_report",
        "//providers/host",
        "//providers/host:host_testing",
        "//tests:core_fuzz_smoke",
        "//tests:core_test",
        "//tests/crypto:oracle_sodium",
        "//web:module",
        "//web:test_module",
    ],
)

QUALITY_INPUTS = [
    "@quality_sdk//:files",
    "@go_sdk//:files",
    "@rust_sdk//:files",
    "//web:browser_packages",
    "//:repository_sources",
    "@emscripten_sdk//:files",
    "quality.py",
    "build_action.py",
    "//:.clang-format",
    "//:.clang-tidy",
    "//core:sources",
    "//providers/host:sources",
    "//providers/sodium:sources",
    "//schema:sources",
    "//third_party/nanopb:sources",
    "//third_party/libsodium:headers",
]

py_test(
    name = "format_check",
    data = QUALITY_INPUTS,
    main = "repository_quality.py",
    script_args = ["format-check"],
)

py_test(
    name = "c_lint",
    data = QUALITY_INPUTS + [":analysis_database"],
    main = "quality.py",
    script_args = [
        "--lint",
        "tools/analysis_database.json",
    ],
)

test_suite(
    name = "quality",
    tests = [
        ":format_check",
        ":lint",
        ":quality_test",
        ":repository_quality_test",
        "//docs:api_check",
        "//docs:binding_docs_test",
        "//docs:example",
    ],
)

py_test(
    name = "quality_test",
    data = QUALITY_INPUTS + [
        "//docs:build_api.py",
        "//docs:doc_inputs",
    ],
    main = "quality_test.py",
)

# Package-local files avoid following build-output or SDK directory symlinks.
filegroup(
    name = "quality_sources",
    srcs = glob(["*"]),
    visibility = ["//visibility:public"],
)

py_test(
    name = "script_lint",
    data = QUALITY_INPUTS,
    main = "repository_quality.py",
    script_args = ["lint"],
)

test_suite(
    name = "lint",
    tests = [
        ":c_lint",
        ":script_lint",
        "//adapters/go:lint",
        "//bindings/go:lint",
        "//bindings/rust:lint",
        "//tests/crypto:lint",
    ],
)

py_test(
    name = "repository_quality_test",
    data = QUALITY_INPUTS,
    main = "repository_quality_test.py",
)
