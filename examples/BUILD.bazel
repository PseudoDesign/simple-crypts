load("//build:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "device_server_demo",
    testonly = True,
    data = [
        "//adapters/c:adapter",
        "//adapters/python:adapter",
        "//tests:coordinator.py",
    ],
    main = "device_server_demo.py",
    script_args = [
        "--device",
        "adapters/c/adapter",
        "--server",
        "adapters/python/adapter",
    ],
    visibility = [
        "//visibility:private",
    ],
)

py_binary(
    name = "python_api",
    data = ["//bindings/python:simplecrypts.py"],
    main = "python_api.py",
    shared = "//providers/host:libsimplecrypts",
)

py_test(
    name = "production_api_test",
    data = ["//bindings/python:simplecrypts.py"],
    main = "python_api.py",
    shared = "//providers/host:libsimplecrypts",
)

# Package-local files avoid following build-output or SDK directory symlinks.
filegroup(
    name = "quality_sources",
    srcs = glob(["*"]),
    visibility = ["//visibility:public"],
)
