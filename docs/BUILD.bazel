load("//build:defs.bzl", "c_test", "py_test")
load(":defs.bzl", "api_docs")

package(default_visibility = ["//visibility:public"])

exports_files(["build_api.py"])

filegroup(
    name = "doc_inputs",
    srcs = [
        "Doxyfile",
        "api.css",
        "api.dox",
        "api_example.c",
        "//core:sources",
        "//examples/common:endpoint.h",
        "//examples/device_console:console.h",
        "//providers/host:sources",
        "//providers/sodium:sources",
    ],
)

INPUTS = [
    ":doc_inputs",
    "binding_docs.py",
    "go_docs.go",
    "//:repository_sources",
    "//tools:repository_quality.py",
    "@language_sources//:rust",
    "//build:dependency_paths",
    "//tools:dependency_paths.py",
    "@rust_sdk//:files",
    "@go_sdk//:files",
    "//web:browser_packages",
    "//tools:quality.py",
    "//tools:source_policy.py",
    "//tools:build_action.py",
]

api_docs(
    name = "api",
    srcs = INPUTS,
)

py_test(
    name = "api_check",
    data = INPUTS,
    main = "build_api.py",
)

c_test(
    name = "example",
    srcs = ["api_example.c"],
    deps = ["//providers/host"],
)

# Package-local files avoid following build-output or SDK directory symlinks.
filegroup(
    name = "quality_sources",
    srcs = glob(["*"]),
    visibility = ["//visibility:public"],
)

py_test(
    name = "binding_docs_test",
    data = INPUTS,
    main = "binding_docs_test.py",
)
