load("//build:defs.bzl", "sdk_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob([
        "src/**",
        "Cargo.*",
    ]),
)

sdk_test(
    name = "sdk_test",
    srcs = [
        ":sources",
    ],
    kind = "rust",
    module = "bindings/rust",
    sdk = "@rust_sdk//:files",
    sdk_marker = "@rust_sdk//:bin/rustc",
    shared = "//providers/host:libsimplecrypts_testing",
    test_build = True,
)

exports_files(["src/resources.rs"])

# Package-local files avoid following build-output or SDK directory symlinks.
filegroup(
    name = "quality_sources",
    srcs = glob([
        "*",
        "src/*",
    ]),
    visibility = ["//visibility:public"],
)

sdk_test(
    name = "lint",
    srcs = [
        ":sources",
        "//adapters/rust:main.rs",
    ],
    kind = "rust",
    module = "bindings/rust",
    quality = True,
    sdk = "@rust_sdk//:files",
    sdk_marker = "@rust_sdk//:bin/rustc",
    shared = "//providers/host:libsimplecrypts_testing",
    test_build = True,
)
