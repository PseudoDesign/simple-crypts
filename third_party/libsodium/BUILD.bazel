load("//build:defs.bzl", "sodium_library")
package(default_visibility = ["//visibility:public"])
filegroup(name = "sources", srcs = glob(["**"], exclude = ["BUILD.bazel"]))
filegroup(name = "headers", srcs = glob(["src/libsodium/include/**/*.h"]))
sodium_library(name = "sodium", srcs = [":sources"], hdrs = [":headers"], configure = "configure")
sodium_library(name = "sodium_arm", srcs = [":sources"], hdrs = [":headers"], configure = "configure", arm = True)
