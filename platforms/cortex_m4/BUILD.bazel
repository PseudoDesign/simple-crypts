load("//build:defs.bzl", "cortex_resource_report")

package(default_visibility = ["//visibility:public"])

cortex_resource_report(
    name = "resource_report",
    srcs = [
        "probe.c",
        "//core:sources",
        "//providers/sodium:sources",
        "//schema:sc.pb.c",
        "//third_party/nanopb:pb_common.c",
        "//third_party/nanopb:pb_decode.c",
        "//third_party/nanopb:pb_encode.c",
    ],
    headers = [
        "//schema:resources.h",
        "//schema:sc.pb.h",
        "//third_party/nanopb:pb.h",
        "//third_party/nanopb:pb_common.h",
        "//third_party/nanopb:pb_encode.h",
        "//third_party/nanopb:pb_decode.h",
        "//third_party/libsodium:headers",
    ],
    linker = "probe.ld",
    sodium = "//third_party/libsodium:sodium_arm",
)

# Package-local files avoid following build-output or SDK directory symlinks.
filegroup(
    name = "quality_sources",
    srcs = glob(["*"]),
    visibility = ["//visibility:public"],
)
