load("//build:defs.bzl", "sdk_binary")

package(default_visibility = ["//visibility:public"])

sdk_binary(
    name = "adapter",
    srcs = [
        "main.rs",
        "//bindings/rust:sources",
    ],
    binary = "simplecrypts-rust",
    kind = "rust",
    module = "bindings/rust",
    sdk = "@rust_sdk//:files",
    sdk_marker = "@rust_sdk//:bin/rustc",
    shared = "//providers/host:libsimplecrypts_testing",
)

# Package-local files avoid following build-output or SDK directory symlinks.
filegroup(
    name = "quality_sources",
    srcs = glob(["*"]),
    visibility = ["//visibility:public"],
)

exports_files(["main.rs"])
