load("//build:defs.bzl", "c_library")

package(default_visibility = ["//visibility:public"])

c_library(
    name = "sodium",
    srcs = ["sc_sodium.c"],
    hdrs = [
        "sc_sodium.h",
        "//core:data.h",
        "//core:sc.h",
        "//schema:resources.h",
    ],
    deps = ["//third_party/libsodium:sodium"],
)

filegroup(
    name = "sources",
    srcs = [
        "sc_sodium.c",
        "sc_sodium.h",
    ],
)

# Package-local files avoid following build-output or SDK directory symlinks.
filegroup(
    name = "quality_sources",
    srcs = glob(["*"]),
    visibility = ["//visibility:public"],
)
