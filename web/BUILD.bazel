load("//build:defs.bzl", "py_binary", "py_test")
load(":defs.bzl", "demo_site", "wasm_build")

package(default_visibility = ["//visibility:public"])

exports_files(["build.py"])

wasm_build(
    name = "sodium",
    inputs = ["//third_party/libsodium:sources"],
    kind = "sodium",
    output = "libsodium_web.a",
)

SOURCES = [
    "bridge.c",
    "//core:sc.c",
    "//providers/sodium:sc_sodium.c",
    "//schema:sc.pb.c",
    "@nanopb//:pb_common.c",
    "@nanopb//:pb_encode.c",
    "@nanopb//:pb_decode.c",
]

HEADERS = [
    "//core:sources",
    "//providers/sodium:sources",
    "//schema:sources",
    "//third_party/nanopb:sources",
    "//third_party/libsodium:headers",
]

wasm_build(
    name = "module",
    inputs = HEADERS,
    kind = "module",
    output = "endpoint.wasm.mjs",
    sodium = ":sodium",
    sources = SOURCES,
)

wasm_build(
    name = "test_module",
    inputs = HEADERS,
    kind = "module",
    output = "endpoint.test.mjs",
    sodium = ":sodium",
    sources = SOURCES,
    testing = True,
)

py_test(
    name = "protocol_test",
    data = [
        "endpoint.mjs",
        "protocol_test.mjs",
        ":module",
        ":test_module",
        "//adapters/c:adapter",
    ],
    main = "run_protocol_test.py",
)

demo_site(
    name = "site",
    inputs = [
        "THIRD_PARTY_NOTICES.txt",
        "index.html",
        "landing.css",
        "demo.html",
        "style.css",
        "app.mjs",
        "lab.mjs",
        "endpoint.mjs",
        "worker.mjs",
        "resources.mjs",
        "//site:report_snapshot",
        "//tools:test_report.py",
    ],
)

py_binary(
    name = "preview",
    data = [":site"],
    main = "preview.py",
)

py_test(
    name = "lab_test",
    data = [
        "endpoint.mjs",
        "lab.mjs",
        "lab_test.mjs",
    ],
    main = "run_lab_test.py",
)

py_test(
    name = "site_test",
    data = [
        "site.py",
        ":site",
        "//tools:test_report.py",
    ],
    main = "site_test.py",
)

# Explicit acceptance target: browser caches and local sockets are prerequisites.
# Kept manual so a core-only checkout need not install browser engines.
filegroup(
    name = "browser_packages",
    srcs = glob(
        ["node_modules/**"],
        allow_empty = True,
    ),
)

py_test(
    name = "browser_test",
    data = [
        "browser_test.mjs",
        ":browser_packages",
        ":site",
    ],
    main = "run_browser_test.py",
    tags = [
        "local",
        "manual",
    ],
)

exports_files(["resources.mjs"])

# Package-local files avoid following build-output or SDK directory symlinks.
filegroup(
    name = "quality_sources",
    srcs = glob(["*"]),
    visibility = ["//visibility:public"],
)
